# Cloud providers are opt-in. A key only marks a provider configured; Atlas
# performs no inference until application code explicitly selects it.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ATLAS_API_KEY=
ATLAS_CLOUD_BASE_URL=
ATLAS_CLOUD_MODEL=

# The existing Atlas Ollama committee remains the default local option.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ministral-3:3b

# Required by the SEC Fair Access policy for live EDGAR requests.
SEC_USER_AGENT=AtlasResearch/0.1 contact@example.com
SEC_CIKS=

# SQLModel persistence uses PostgreSQL in provisioned environments. Offline
# business-logic tests use injected repositories and never require a database.
DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5432/atlas
REDIS_URL=redis://127.0.0.1:6379/0

# ATLAS V4 reads MT5 only through a loopback bridge. No order endpoint exists.
MT5_ENABLED=false
MT5_BRIDGE_BASE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=
MT5_TIMEOUT_SECONDS=3
# Optional safety assertion: DEMO, REAL, or CONTEST.
MT5_EXPECTED_ACCOUNT_MODE=DEMO

# Experimental research features are disabled by default and have no signal authority.
ENABLE_ELLIOTT_WAVE=false
ENABLE_FIBONACCI=false

# Optional defense in depth for state-changing /api/v4 routes. When set, use a
# random value of at least 32 characters in the X-Atlas-Admin-Token header.
ATLAS_ADMIN_TOKEN=
ATLAS_MAX_REQUEST_BYTES=2097152
ATLAS_MUTATION_RATE_LIMIT=120

FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=
OPENFIGI_API_KEY=
