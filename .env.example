PORT=3003
HOST=127.0.0.1

# Read-only MetaTrader 5 loopback bridge (Windows only).
MT5_ENABLED=false
MT5_PYTHON_PATH=python
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_REQUIRE_VISIBLE=true
MT5_PORTABLE=false
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_TOKEN=
MT5_SYMBOL_MAP=

# Four loopback-only Ollama servers. Enable only after the runtime and all
# four models have been installed with scripts/setup-local-llms.ps1.
LOCAL_LLM_ENABLED=false
OLLAMA_MANAGE_SERVERS=false
OLLAMA_PRIMARY_PORT=11434
OLLAMA_RELAY_PORTS=11435,11436,11437
OLLAMA_EXECUTABLE=.atlas-local-llm\runtime\ollama.exe
OLLAMA_MODELS_DIR=.atlas-local-llm\models

# Analysis-only Python bridge. It exposes order-flow research and local-LLM
# routing on loopback and contains no broker order endpoint.
ATLAS_INTELLIGENCE_ENABLED=false
ATLAS_PYTHON_PATH=python
ATLAS_TEST_PYTHON_PATH=.venv\Scripts\python.exe
ATLAS_INTELLIGENCE_PORT=8776
ATLAS_INTELLIGENCE_TOKEN=

# V4 provider-managed macro/news/event context. A free FRED API key is required
# for numeric FRED series and its date-only release calendar. No key is needed
# for the fixed official central-bank RSS feeds or CFTC public positioning data.
V4_CONTEXT_REFRESH_ENABLED=false
FRED_API_KEY=
OFFICIAL_NEWS_ENABLED=true

# V4 Phase 6 non-voting specialist review. This uses only the local Ollama
# provider and never turns model confidence into Atlas probability.
V4_AI_REVIEW_ENABLED=false
V4_AI_CANDIDATE_THRESHOLD=0.55
V4_AI_REVIEW_TIMEOUT_SECONDS=30
V4_AI_REVIEW_MAX_TOKENS=120

# Persistent V4 market/evidence worker. It begins immediately at backend
# startup, then repeats at the configured fixed delay. Empty instruments means
# the full approved FX/commodity universe. Broker order submission remains off.
V4_ORCHESTRATION_ENABLED=false
V4_ORCHESTRATION_INTERVAL_SECONDS=300
V4_ORCHESTRATION_INSTRUMENTS=
V4_ORCHESTRATION_TRAIN_MODELS=true
V4_ORCHESTRATION_AUTO_SHADOW=false

# Optional Kronos-base financial foundation model specialist. Kronos starts in
# SHADOW with zero signal authority and zero production weight. Configure a
# pinned local checkout of the official MIT-licensed repository and install its
# dependencies in an isolated runtime before enabling. Do not mark the
# pretraining cutoff verified unless the model publisher provides auditable
# evidence for the evaluation period.
KRONOS_ENABLED=false
KRONOS_MODE=SHADOW
KRONOS_REPOSITORY_PATH=
KRONOS_SOURCE_REVISION=
KRONOS_MODEL_ID=NeoQuasar/Kronos-base
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=
KRONOS_SAMPLE_COUNT=200
KRONOS_HORIZON_BARS=12
KRONOS_EFFECTIVE_WEIGHT=0
KRONOS_MAX_WEIGHT=0.25
KRONOS_PREPROCESSING_AUDIT_APPROVED=false
KRONOS_PRETRAINING_CUTOFF_VERIFIED=false
